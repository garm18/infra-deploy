# Node.js / Nuxt / Vite
# ============================================================
node_modules/
**/node_modules/

.nuxt/
**/.nuxt/

.output/
**/.output/

dist/
**/dist/

.vite/
**/.vite/

.nitro/
**/.nitro/

.cache/
**/.cache/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


